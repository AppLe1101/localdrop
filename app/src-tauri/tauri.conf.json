{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalDrop",
  "version": "0.1.0",
  "identifier": "com.ablochko.localdrop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalDrop",
        "width": 965,
        "height": 635,
        "minWidth": 640,
        "minHeight": 500,
        "visible": false,
        "decorations": false,
        "center": true
      },
      {
        "label": "dropzone",
        "title": "Drop Zone",
        "url": "index.html",
        "width": 300,
        "height": 380,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }

    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "ablochko",
    "copyright": "© 2026 ablochko",
    "shortDescription": "Fast file transfer over a local network",
    "longDescription": "LocalDrop transfers files, folders, and text between devices on the same network—no cloud or registration required. It features encryption, trusted devices, and browser-based links.",
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"], "displayLanguageSelector": true },
      "wix": { "language": "ru-RU" }
    },
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
